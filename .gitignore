# dependencies
node_modules/

# package manager logs
pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# turbo
.turbo/

# build outputs
dist/
build/
coverage/
apps/web/test-results/
apps/cflop/test-results/

# lighthouse reports (written by infra/scripts/lighthouse.mjs, never uploaded)
.lighthouse/

# TypeScript
*.tsbuildinfo

# env files
.env
.env.local
.env.*.local

# local sqlite files
packages/db/local/*.sqlite
packages/db/local/*.sqlite-shm
packages/db/local/*.sqlite-wal
packages/db/local/*.sqlite-journal

# editor and OS files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# misc
*.log

# Claude Code state. Per-developer by default: scheduler state, the agent
# worktrees under .claude/worktrees/, and settings.local.json. The negations are
# the repo conventions a clone must not miss — the skills AGENTS.md points at,
# the subagents those skills dispatch by name, and settings.json, whose
# PostToolUse hook surfaces the writing-docs skill on a documentation edit. The
# lines are not interchangeable: git does not descend into an excluded
# directory, so the exclusion has to be `.claude/*` for the negations to be
# reachable at all.
.claude/*
!.claude/skills/
!.claude/agents/
!.claude/settings.json

# issue workflow artifacts
.notes/

# design-sync (claude.ai/design)
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules

# TanStack Router plugin scratch output, regenerated on every dev/build run.
.tanstack/

# Prerender driver output. A vite SSR bundle, kept out of `dist/` because the
# Dockerfile copies `dist` wholesale into the nginx image.
apps/cflop/.prerender/
