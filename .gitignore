# dependencies
node_modules/

# package manager logs
pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# turbo
.turbo/

# build outputs
dist/
build/
coverage/
apps/web/test-results/
apps/cube-trainer/test-results/

# lighthouse reports (written by infra/scripts/lighthouse.mjs, never uploaded)
.lighthouse/

# TypeScript
*.tsbuildinfo

# env files
.env
.env.local
.env.*.local

# local sqlite files
packages/db/local/*.sqlite
packages/db/local/*.sqlite-shm
packages/db/local/*.sqlite-wal
packages/db/local/*.sqlite-journal

# editor and OS files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# misc
*.log

# Claude Code local state. `.claude/settings.json` is deliberately NOT ignored:
# project-scoped settings are meant to be shared. Only per-developer state is.
.claude/settings.local.json
.claude/settings.local.json.bak.*
.claude/scheduled_tasks.lock
.claude/worktrees/

# issue workflow artifacts
.issues/
.issues/*.md

# design-sync (claude.ai/design)
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
