# dependencies
node_modules/

# package manager logs
pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# turbo
.turbo/

# build outputs
dist/
build/
coverage/
apps/web/test-results/
apps/cflop/test-results/

# lighthouse reports (written by infra/scripts/lighthouse.mjs, never uploaded)
.lighthouse/

# TypeScript
*.tsbuildinfo

# env files
.env
.env.local
.env.*.local

# local sqlite files
packages/db/local/*.sqlite
packages/db/local/*.sqlite-shm
packages/db/local/*.sqlite-wal
packages/db/local/*.sqlite-journal

# editor and OS files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# misc
*.log

# Claude Code state. Settings, scheduler state and the agent worktrees under
# .claude/worktrees/ are per-developer; skills are repo conventions and are
# tracked, because AGENTS.md points at them and a clone that lacks them reads an
# instruction it cannot follow. The two lines are not interchangeable: git does
# not descend into an excluded directory, so the exclusion has to be `.claude/*`
# for the negation below to be reachable at all.
.claude/*
!.claude/skills/

# issue workflow artifacts
.notes/

# design-sync (claude.ai/design)
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules

# TanStack Router plugin scratch output, regenerated on every dev/build run.
.tanstack/
