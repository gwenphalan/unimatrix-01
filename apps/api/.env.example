# Optional local-development runtime config for the API.
# This file is auto-bootstrapped by `pnpm dev` and `pnpm setup:local` when missing.
# Deployment-oriented examples live in `apps/api/.env.production.example`.
# The API startup entrypoint auto-loads `apps/api/.env` when this file is present.
HOST=127.0.0.1
PORT=3001
NODE_ENV=development
LOG_LEVEL=debug
TRUST_PROXY=false

# Maximum accepted size, in bytes, for a single per-user file upload
# (POST /me/files). Defaults to 5242880 (5 MiB) when unset.
# MAX_UPLOAD_BYTES=5242880

# Cumulative cap, in bytes, on everything one user stores across documents
# (PUT /me/data) and files (POST /me/files) combined. Defaults to 52428800
# (50 MiB) when unset. A write that would cross it is refused with 413.
# MAX_USER_STORAGE_BYTES=52428800

# Clerk auth is optional in development: leave all three unset to run
# without auth, or set all three (never just some) to enable it locally.
# Get real values from the Clerk dashboard; never commit real secrets.
# CLERK_SECRET_KEY=sk_test_placeholder
# CLERK_PUBLISHABLE_KEY=pk_test_placeholder
# CLERK_JWT_KEY=jwt_key_placeholder

# Integration credentials are optional and off by default: leave both unset
# to boot with no secrets store client, or set both together (never just
# one) to fetch the names in SECRETS_INTEGRATION_NAMES from apps/secrets at
# boot. There is no shared network between the two stacks yet in local dev
# or in production — see docs/deployment.md — so leave these unset until
# that lands.
# SECRETS_BASE_URL=http://127.0.0.1:3002
# SECRETS_SERVICE_TOKEN=svc_read_placeholder
# SECRETS_INTEGRATION_NAMES=github/token

# The admin secrets console's manage-capability token. Optional, and only
# valid alongside SECRETS_BASE_URL/SECRETS_SERVICE_TOKEN above: leave unset
# to boot with the four admin secrets routes absent, or set it to register
# them. Must be a manage-capability token (not the read-capability
# SECRETS_SERVICE_TOKEN above), and setting it to that same value is refused
# at startup: the store answers a wrong-capability caller with the same 404 it
# uses for a missing secret, so a shared token would otherwise boot cleanly,
# list nothing, and report every mutation as not-found with nothing saying why.
# SECRETS_MANAGE_TOKEN=svc_manage_placeholder
