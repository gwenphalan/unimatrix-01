# Optional local-development runtime config for the API.
# This file is auto-bootstrapped by `pnpm dev` and `pnpm setup:local` when missing.
# Deployment-oriented examples live in `apps/api/.env.production.example`.
# The API startup entrypoint auto-loads `apps/api/.env` when this file is present.
HOST=127.0.0.1
PORT=3001
NODE_ENV=development
LOG_LEVEL=debug
TRUST_PROXY=false

# Maximum accepted size, in bytes, for a single per-user file upload
# (POST /me/files). Defaults to 5242880 (5 MiB) when unset.
# MAX_UPLOAD_BYTES=5242880

# Cumulative cap, in bytes, on everything one user stores across documents
# (PUT /me/data) and files (POST /me/files) combined. Defaults to 52428800
# (50 MiB) when unset. A write that would cross it is refused with 413.
# MAX_USER_STORAGE_BYTES=52428800

# Clerk auth is optional in development: leave all three unset to run
# without auth, or set all three (never just some) to enable it locally.
# Get real values from the Clerk dashboard; never commit real secrets.
# CLERK_SECRET_KEY=sk_test_placeholder
# CLERK_PUBLISHABLE_KEY=pk_test_placeholder
# CLERK_JWT_KEY=jwt_key_placeholder

# Integration credentials are optional and off by default: leave both unset
# to boot with no secrets store client, or set both together (never just one)
# to fetch the integration-tier names in SECRET_REGISTRY (@unimatrix/shared)
# from apps/secrets at boot. In production both stacks join the external
# unimatrix-secrets network and the store is HTTPS-only (see
# docs/deployment.md). Locally, set these only when you are running
# apps/secrets yourself.
# SECRETS_BASE_URL=http://127.0.0.1:3002
# SECRETS_SERVICE_TOKEN=svc_read_placeholder

# The admin secrets console's two scoped tokens, both only valid alongside
# SECRETS_BASE_URL/SECRETS_SERVICE_TOKEN above. Set both to register the four
# admin secrets routes; with either missing they are all absent, because a
# console that can reach one tier would show the other as "not set" rather
# than "not reachable".
#
# A service token carries exactly one scope prefix and no wildcard, so no
# single token spans both tiers — and one that did would carry delete rights
# over platform/*. Hence one `manage` token scoped to `integrations` and one
# `write` token (create and rotate, never delete) scoped to `platform`.
#
# All three tokens here must differ, which is checked at startup: the store
# answers a wrong-capability or out-of-scope caller with the same 404 it uses
# for a missing secret, so a shared token would otherwise boot cleanly and
# report every call it cannot make as not-found with nothing saying why.
# SECRETS_INTEGRATIONS_MANAGE_TOKEN=svc_integrations_manage_placeholder
# SECRETS_PLATFORM_WRITE_TOKEN=svc_platform_write_placeholder
