# Example production runtime config for the API.
# Set these values in your deployment environment instead of committing a live `.env.production`.
# `CORS_ALLOWED_ORIGINS` fully replaces the repo defaults when it is set.
# Add the omnimatrix.dev origins here if or when that hostname becomes public for v1.
HOST=0.0.0.0
PORT=3001
NODE_ENV=production
LOG_LEVEL=info
TRUST_PROXY=1
CORS_ALLOWED_ORIGINS=https://unimatrix-01.dev,https://*.unimatrix-01.dev

# Maximum accepted size, in bytes, for a single per-user file upload
# (POST /me/files). Defaults to 5242880 (5 MiB) when unset.
MAX_UPLOAD_BYTES=5242880

# Cumulative cap, in bytes, on everything one user stores across documents
# (PUT /me/data) and files (POST /me/files) combined. Defaults to 52428800
# (50 MiB) when unset. A write that would cross it is refused with 413.
MAX_USER_STORAGE_BYTES=52428800

# CLERK_SECRET_KEY, CLERK_PUBLISHABLE_KEY, and CLERK_JWT_KEY are all
# required in production. Set real values in your deployment environment;
# never commit real secrets.
CLERK_SECRET_KEY=sk_live_placeholder
CLERK_PUBLISHABLE_KEY=pk_live_placeholder
CLERK_JWT_KEY=jwt_key_placeholder

# Integration credentials are optional and off by default: leave both unset
# to boot with no secrets store client, or set both together (never just one)
# to fetch the integration-tier names in SECRET_REGISTRY (@unimatrix/shared)
# from apps/secrets at boot. Deployment has no shared network between the two
# stacks yet — see docs/deployment.md — so these stay unset in production
# until that lands.
# SECRETS_BASE_URL=http://secrets:3002
# SECRETS_SERVICE_TOKEN=svc_read_placeholder

# The admin secrets console's two scoped tokens: a `manage` token scoped to
# `integrations` and a `write` token (create and rotate, never delete) scoped
# to `platform`. Both are needed to register the admin secrets routes, and all
# three tokens on this page must differ — see apps/api/.env.example for why
# each of those rules exists.
# SECRETS_INTEGRATIONS_MANAGE_TOKEN=svc_integrations_manage_placeholder
# SECRETS_PLATFORM_WRITE_TOKEN=svc_platform_write_placeholder
