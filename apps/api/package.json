{
  "name": "@unimatrix/api",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal Fastify API shell for the Unimatrix monorepo.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "seed:content": "tsx scripts/seed-content.ts",
    "test": "node --import tsx --test --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-lines=85 --test-coverage-functions=84 test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^11.1.0",
    "@unimatrix/auth": "workspace:*",
    "@unimatrix/db": "workspace:*",
    "@unimatrix/shared": "workspace:*",
    "drizzle-orm": "^0.45.1",
    "fastify": "^5.6.1",
    "fastify-type-provider-zod": "^7.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@unimatrix/config-eslint": "workspace:*",
    "@unimatrix/config-typescript": "workspace:*",
    "@unimatrix/content": "workspace:*",
    "eslint": "^10.0.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
