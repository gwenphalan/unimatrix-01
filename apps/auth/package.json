{
  "name": "@unimatrix/auth-app",
  "version": "0.1.0",
  "private": true,
  "description": "Clerk-backed accounts app for the Unimatrix monorepo: sign-in/sign-up, account management, and a permissions admin panel.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "pnpm run test:unit",
    "test:unit": "pnpm --filter @unimatrix/ui build && vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/router-plugin": "^1.166.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@unimatrix/config-eslint": "workspace:*",
    "@unimatrix/config-typescript": "workspace:*",
    "@unimatrix/config-vitest": "workspace:*",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.0.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.2",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@remixicon/react": "^4.9.0",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-router": "^1.166.6",
    "@unimatrix/auth": "workspace:*",
    "@unimatrix/ui": "workspace:^",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  }
}
