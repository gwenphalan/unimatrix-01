{
  "name": "@unimatrix/cflop",
  "version": "0.1.0",
  "private": true,
  "description": "Rubik's Cube OLL/PLL algorithm learning and training app for the Unimatrix monorepo.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vite build && vite build --ssr prerender/entry.tsx --outDir .prerender --emptyOutDir && node .prerender/entry.js",
    "dev": "vite",
    "gen:algs": "vite build --ssr scripts/generate-algorithm-data.ts --outDir .generate --emptyOutDir && node .generate/generate-algorithm-data.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "pnpm run test:unit && pnpm run test:smoke",
    "test:smoke": "playwright test",
    "test:unit": "pnpm --filter @unimatrix/ui build && vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/router-plugin": "^1.168.32",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@unimatrix/config-eslint": "workspace:*",
    "@unimatrix/config-typescript": "workspace:*",
    "@unimatrix/config-vitest": "workspace:*",
    "@unimatrix/deploy-config": "workspace:*",
    "@unimatrix/e2e-helpers": "workspace:*",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.8.1",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@remixicon/react": "^4.9.0",
    "@tanstack/react-router": "^1.170.29",
    "@unimatrix/chrome": "workspace:^",
    "@unimatrix/cube": "workspace:^",
    "@unimatrix/ui": "workspace:^",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.3.6"
  }
}
