{
  "name": "@unimatrix/deploy-app",
  "version": "0.1.0",
  "private": true,
  "description": "Fastify service scaffold holding a typed Dokploy API client.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "reconcile": "tsx src/cli/reconcile.ts",
    "lint": "eslint .",
    "test": "node --import tsx --test --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-lines=96 --test-coverage-functions=97 test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@unimatrix/secrets": "workspace:*",
    "@unimatrix/shared": "workspace:*",
    "fastify": "^5.11.3",
    "fastify-type-provider-zod": "^7.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@unimatrix/config-eslint": "workspace:*",
    "@unimatrix/config-typescript": "workspace:*",
    "@unimatrix/deploy-config": "workspace:*",
    "eslint": "^10.8.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  }
}
