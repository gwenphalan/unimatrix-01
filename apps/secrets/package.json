{
  "name": "@unimatrix/secrets-app",
  "version": "0.1.0",
  "private": true,
  "description": "Fastify service for the Unimatrix secrets store — sealed value storage under a versioned KEK ring.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "token": "tsx src/cli/service-token.ts",
    "lint": "eslint .",
    "test": "node --import tsx --test --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-lines=95 --test-coverage-functions=93 test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts"
  },
  "dependencies": {
    "@unimatrix/secrets": "workspace:*",
    "@unimatrix/shared": "workspace:*",
    "better-sqlite3": "^12.6.2",
    "drizzle-orm": "^0.45.1",
    "fastify": "^5.6.1",
    "fastify-type-provider-zod": "^7.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.13.3",
    "@unimatrix/config-eslint": "workspace:*",
    "@unimatrix/config-typescript": "workspace:*",
    "@unimatrix/deploy-config": "workspace:*",
    "drizzle-kit": "^0.31.9",
    "eslint": "^10.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
