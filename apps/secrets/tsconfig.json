{
  "extends": "@unimatrix/config-typescript/base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "paths": {
      "@unimatrix/deploy-config": ["../../packages/deploy-config/src/index.ts"],
      "@unimatrix/secrets": ["../../packages/secrets/src/index.ts"],
      "@unimatrix/shared": ["../../packages/shared/src/index.ts"]
    },
    "types": ["node"]
  },
  // `deploy.config.ts` and `drizzle.config.ts` are checked but deliberately absent from
  // `tsconfig.build.json`: neither is part of the deployable server build — both are read by
  // tooling through Node type stripping, never imported by app code.
  "include": ["deploy.config.ts", "drizzle.config.ts", "src/**/*.ts", "test/**/*.ts"]
}
