{
  "name": "@unimatrix/web",
  "version": "0.1.0",
  "private": true,
  "description": "Vite-based web app shell for the Unimatrix monorepo.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "pnpm run test:unit && pnpm run test:smoke",
    "test:smoke": "playwright test",
    "test:unit": "pnpm --filter @unimatrix/ui build && vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.54.2",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/router-plugin": "^1.166.6",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@unimatrix/config-eslint": "workspace:*",
    "@unimatrix/config-typescript": "workspace:*",
    "@unimatrix/config-vitest": "workspace:*",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.0.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@remixicon/react": "^4.9.0",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-router": "^1.166.6",
    "@unimatrix/api-client": "workspace:*",
    "@unimatrix/auth": "workspace:*",
    "@unimatrix/content": "workspace:*",
    "@unimatrix/ui": "workspace:^",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  }
}
