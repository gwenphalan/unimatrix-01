{
  "name": "unimatrix-01",
  "version": "0.1.0",
  "private": true,
  "description": "Initial monorepo foundation for the Unimatrix ecosystem.",
  "license": "MIT",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22",
    "pnpm": "10.30.3"
  },
  "scripts": {
    "dev": "node ./infra/scripts/dev.mjs",
    "setup:local": "node ./infra/scripts/setup-local.mjs",
    "setup:worktree": "node ./infra/scripts/setup-worktree.mjs",
    "db:migrate": "pnpm --filter @unimatrix/db db:migrate",
    "db:generate": "pnpm --filter @unimatrix/db db:generate",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deps:check": "syncpack lint",
    "deps:fix": "syncpack fix",
    "lighthouse": "node ./infra/scripts/lighthouse.mjs apps/web && node ./infra/scripts/lighthouse.mjs apps/cube-trainer",
    "check:app-wiring": "bash ./infra/scripts/check-app-wiring.sh",
    "check": "pnpm format:check && pnpm deps:check && pnpm check:app-wiring && turbo run lint typecheck test",
    "knip": "knip",
    "verify": "pnpm format:check && pnpm deps:check && pnpm check:app-wiring && turbo run build lint typecheck test"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "chrome-launcher": "^1.2.1",
    "eslint": "^10.0.0",
    "jsdom": "^29.1.1",
    "knip": "^6.29.0",
    "lighthouse": "^13.4.1",
    "prettier": "^3.9.6",
    "syncpack": "^15.3.2",
    "turbo": "^2.8.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
