{
  "name": "unimatrix-01",
  "version": "0.1.0",
  "private": true,
  "description": "Initial monorepo foundation for the Unimatrix ecosystem.",
  "license": "MIT",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22",
    "pnpm": "10.30.3"
  },
  "scripts": {
    "prepare": "if [ -f infra/scripts/install-git-hooks.mjs ]; then node ./infra/scripts/install-git-hooks.mjs; fi",
    "dev": "node ./infra/scripts/dev.mjs",
    "setup:local": "node ./infra/scripts/setup-local.mjs",
    "setup:worktree": "node ./infra/scripts/setup-worktree.mjs",
    "db:migrate": "pnpm --filter @unimatrix/db db:migrate",
    "db:generate": "pnpm --filter @unimatrix/db db:generate",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deps:check": "syncpack lint",
    "deps:fix": "syncpack fix",
    "lighthouse": "node ./infra/scripts/lighthouse.mjs apps/web && node ./infra/scripts/lighthouse.mjs apps/cflop",
    "check:app-wiring": "bash ./infra/scripts/check-app-wiring.sh",
    "check:agents-md": "bash ./infra/scripts/check-agents-md-symlinks.sh",
    "check:stale-comments": "node ./infra/scripts/check-stale-comments.mjs",
    "check:doc-script-refs": "bash ./infra/scripts/check-doc-script-refs.sh",
    "check:deploy-config": "node ./infra/scripts/validate-deploy-config.mjs && node ./infra/scripts/generate-deploy-config.mjs --check",
    "check:runner-labels": "node ./infra/scripts/check-runner-labels.mjs",
    "check:coverage-drift": "node ./infra/scripts/check-coverage-drift.mjs",
    "check:ship-pr-fixtures": "bash ./.claude/skills/ship-pr/scripts/fixtures/run-fixtures.sh",
    "check:reminder-hooks": "bash ./infra/scripts/check-reminder-hooks.sh",
    "check:todo-citations": "bash ./infra/scripts/check-todo-citations.sh",
    "check:scratch-untracked": "node ./infra/scripts/check-scratch-not-tracked.mjs",
    "check": "pnpm format:check && pnpm deps:check && pnpm check:app-wiring && pnpm check:agents-md && pnpm check:stale-comments && pnpm check:doc-script-refs && pnpm check:deploy-config && pnpm check:runner-labels && pnpm check:ship-pr-fixtures && pnpm check:reminder-hooks && pnpm check:todo-citations && pnpm check:scratch-untracked && turbo run lint typecheck test && pnpm check:coverage-drift",
    "knip": "knip",
    "verify": "pnpm format:check && pnpm deps:check && pnpm check:app-wiring && pnpm check:agents-md && pnpm check:stale-comments && pnpm check:doc-script-refs && pnpm check:deploy-config && pnpm check:runner-labels && pnpm check:ship-pr-fixtures && pnpm check:reminder-hooks && pnpm check:todo-citations && pnpm check:scratch-untracked && turbo run build lint typecheck test && pnpm check:coverage-drift"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "chrome-launcher": "^1.2.1",
    "eslint": "^10.8.1",
    "jsdom": "^29.1.1",
    "knip": "^6.31.0",
    "lighthouse": "^13.4.1",
    "prettier": "^3.9.6",
    "syncpack": "^15.3.3",
    "turbo": "^2.10.9",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
