{
  "name": "@unimatrix/content",
  "version": "0.1.0",
  "private": true,
  "description": "Typed content system boundary for repo-backed authored content.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@unimatrix/config-eslint": "workspace:*",
    "@unimatrix/config-typescript": "workspace:*",
    "@unimatrix/config-vitest": "workspace:*",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.0.0",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  }
}
